# syntax=docker/dockerfile:1
# QueueNow API (NestJS) production image.
#
# Debian-slim base (not alpine) so bcrypt's prebuilt native binary installs
# without a musl recompile. Builds the workspace deps the API needs
# (@queuenow/db + shared-*), generates the Prisma client, then runs the
# compiled server.

# ---- Builder ----
FROM node:22-slim AS builder
RUN corepack enable
WORKDIR /app

# Source (node_modules/dist excluded via .dockerignore).
COPY . .

# Install all workspace deps. The root package.json `pnpm.onlyBuiltDependencies`
# allowlist lets bcrypt/prisma run their install scripts under pnpm 10.
RUN pnpm install --frozen-lockfile

# Generate the Prisma client, then build the DB package and the API
# (Prisma now lives in packages/database, not apps/api).
RUN pnpm db:generate
RUN pnpm --filter @queuenow/db build
RUN pnpm --filter @queuenow/api build

# ---- Runner ----
FROM node:22-slim AS runner
RUN corepack enable \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends openssl \
	&& rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production

# Carry the built workspace (node_modules + dist + generated Prisma client +
# schema for `migrate deploy`). Simple and correct for an MVP image.
COPY --from=builder /app ./

EXPOSE 4000

# Run DB migrations as a separate release/pre-deploy step:
#   pnpm --filter @queuenow/db migrate:deploy
CMD ["node", "apps/api/dist/main.js"]

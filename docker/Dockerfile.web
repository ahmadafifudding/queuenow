# syntax=docker/dockerfile:1
# QueueNow Web (React/Vite) production image.
#
# Vite inlines env at BUILD time, so the production API/WS URLs must be passed
# as build args. The built static SPA is served by nginx with an SPA fallback.
#
# Build example:
#   docker build -f docker/Dockerfile.web \
#     --build-arg VITE_API_URL=https://api.example.com/api/v1 \
#     --build-arg VITE_WS_URL=https://api.example.com \
#     -t queuenow-web .

# ---- Builder ----
FROM node:22-slim AS builder
RUN corepack enable
WORKDIR /app

ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @queuenow/web build

# ---- Runner (static nginx) ----
FROM nginx:alpine AS runner
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

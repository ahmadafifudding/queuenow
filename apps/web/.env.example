# QueueNow Web (apps/web) environment configuration.
#
# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Every variable is validated on boot by lib/env.ts (Zod) — the app will refuse
# to start and show a fatal-config screen if any is missing or malformed.
#
# All web env vars MUST be prefixed with VITE_ to be exposed to the client.
# Never commit a real .env file.

# REST API base URL (must be a valid URL, e.g. include the /api/v1 prefix).
VITE_API_URL=http://localhost:4000/api/v1

# Socket.io base URL (must be a valid URL; no namespace suffix).
VITE_WS_URL=http://localhost:4000

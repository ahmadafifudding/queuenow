# QueueNow Mobile (apps/mobile) environment configuration.
#
# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Every variable is validated on boot by src/lib/env.ts (Zod) — the app will
# fail fast with a named error if any is missing or malformed.
#
# All public mobile env vars MUST be prefixed with EXPO_PUBLIC_ so Expo inlines
# them into the bundle (process.env.EXPO_PUBLIC_*). Never commit a real .env.

# REST API base URL (must be a valid URL, e.g. include the /api/v1 prefix).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.io base URL (must be a valid URL; no namespace suffix).
EXPO_PUBLIC_WS_URL=http://localhost:4000

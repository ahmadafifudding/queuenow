{
  "name": "queue-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @queue-system/api prisma generate",
    "db:migrate": "pnpm --filter @queue-system/api prisma migrate dev",
    "db:push": "pnpm --filter @queue-system/api prisma db push",
    "db:studio": "pnpm --filter @queue-system/api prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.6.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
